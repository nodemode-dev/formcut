#!/usr/bin/env bash
# formcut macOS/Linux installation. Idempotent: safe to run on every boot.
# Lives in setup/; resolves the repo root itself, so it works from anywhere.
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

VERSION="$(sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([^"]*\)".*/\1/p' frontend/package.json | head -1)"

echo "==========================================="
echo "formcut v${VERSION} - Installation"
echo "==========================================="
echo ""

# ffmpeg is a hard requirement and stays external, so say so before the long steps.
for tool in ffmpeg ffprobe; do
  command -v "$tool" >/dev/null 2>&1 || echo "WARNING: $tool is not on PATH. Import, preview and export need it."
done

echo ">> Setting up the engine..."
chmod +x backend/oc_install backend/boot_backend 2>/dev/null || true
(cd backend && ./oc_install)

# The Rust frame path (formcut_native with the gpu feature): built into backend/venv when a Rust toolchain
# is here, and rebuilt only when its sources change (a checksum of them, kept in the venv). Without cargo the
# engine runs its Python frame path, which is the same picture, slower.
NATIVE_SUM="$(cat backend/native/Cargo.toml backend/native/Cargo.lock backend/native/src/*.rs 2>/dev/null | cksum | cut -d' ' -f1)"
NATIVE_STAMP="backend/venv/.formcut_native_stamp"
if command -v cargo >/dev/null 2>&1 || [ -x "$HOME/.cargo/bin/cargo" ]; then
  PATH="$HOME/.cargo/bin:$PATH"
  export PATH
  if [ "$(cat "$NATIVE_STAMP" 2>/dev/null)" != "$NATIVE_SUM" ]; then
    echo ""
    echo ">> Building the Rust frame path (formcut_native)..."
    chmod +x setup/build_native_gpu 2>/dev/null || true
    if setup/build_native_gpu; then
      echo "$NATIVE_SUM" > "$NATIVE_STAMP"
    else
      echo ">> The Rust frame path did not build; the engine runs its Python frame path. Output above."
    fi
  fi
else
  echo ""
  echo ">> No Rust toolchain (https://rustup.rs): the engine runs its Python frame path."
fi

echo ""
echo ">> Setting up the interface..."
chmod +x frontend/oc_install frontend/boot_frontend 2>/dev/null || true
(cd frontend && ./oc_install)

if [ ! -f .env ] && [ -f example.env ]; then
  cp example.env .env
  echo ""
  echo ">> Created .env from example.env. Keys go there; it is ignored by git."
fi

chmod +x formcut setup/formcut_banner setup/formcut_boot setup/formcut_oc_install setup/setup_local_ai 2>/dev/null || true

echo ""
echo "==========================================="
echo "Installation complete"
echo "==========================================="
echo ""
echo "Next steps:"
echo "  1. Add any keys to .env (PEXELS_API_KEY, ELEVENLABS_API_KEY); both are optional"
echo "  2. Run: ./formcut"
echo ""
echo "Also:"
echo "  - ./formcut installs the local speech runtime on first boot (setup/setup_local_ai); the Kokoro voice model downloads from Studio"
echo "  - Caption and cutout models download into models/ on first engine start; after that nothing reaches the network"
echo ""

#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/.." && pwd)"
py="${1:?usage: setup/build_lgpl_av <engine venv python>}"
FFMPEG_VERSION=8.0.3
FFMPEG_SHA256=6136812ea6d4e68bdba27e33c2a94382711cdf4f8602ffef056ff792bd6f9818
AV_VERSION=18.1.0
prefix="${LGPL_FFMPEG_PREFIX:-$root/backend/.lgpl-ffmpeg}"
work="$root/backend/build/lgpl-ffmpeg"
say() { printf '[lgpl-av] %s\n' "$*"; }
[ -x "$py" ] || { say "python not found: $py"; exit 1; }
jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 2)"
extra=(--enable-zlib)
[ "$(uname -s)" = Darwin ] && extra+=(--enable-videotoolbox --enable-audiotoolbox)
if [ ! -f "$prefix/lib/pkgconfig/libavcodec.pc" ]; then
  mkdir -p "$work"
  tarball="$work/ffmpeg-$FFMPEG_VERSION.tar.xz"
  [ -f "$tarball" ] || curl -fL --retry 3 -o "$tarball" "https://ffmpeg.org/releases/ffmpeg-$FFMPEG_VERSION.tar.xz"
  sum="$( (sha256sum "$tarball" 2>/dev/null || shasum -a 256 "$tarball") | cut -d' ' -f1)"
  [ "$sum" = "$FFMPEG_SHA256" ] || { say "checksum mismatch for $tarball"; exit 1; }
  rm -rf "$work/src" && mkdir -p "$work/src"
  tar -xJf "$tarball" -C "$work/src" --strip-components 1
  # x86 builds assemble FFmpeg's SIMD paths with nasm; Apple silicon (NEON) does not need it. GitHub's Intel Mac
  # runner has no nasm, so it is installed there, as setup/build_lgpl_ffmpeg_msvc does with pacman on Windows.
  if [ "$(uname -m)" = x86_64 ] && ! command -v nasm >/dev/null 2>&1; then
    if [ "$(uname -s)" = Darwin ] && command -v brew >/dev/null 2>&1; then
      say "installing nasm, FFmpeg's x86 assembler"
      brew install nasm >/dev/null
    else
      say "nasm is required to build FFmpeg for x86_64: install it first"; exit 1
    fi
  fi
  say "building FFmpeg $FFMPEG_VERSION (LGPL, shared) into $prefix"
  if ! (cd "$work/src" && ./configure --prefix="$prefix" --enable-shared --disable-static \
    --disable-gpl --disable-nonfree --disable-version3 \
    --disable-programs --disable-doc --disable-debug --disable-autodetect --disable-network "${extra[@]}" \
    --extra-ldflags="-Wl,-rpath,$prefix/lib" >/dev/null); then
    say "FFmpeg's configure failed; the end of its log:"
    tail -n 40 "$work/src/ffbuild/config.log" 2>/dev/null || true
    exit 1
  fi
  (cd "$work/src" && make -j"$jobs" >/dev/null && make install >/dev/null)
fi
grep -aq "libavcodec license: LGPL" "$prefix"/lib/libavcodec.* || { say "the FFmpeg in $prefix is not LGPL"; exit 1; }
say "building PyAV $AV_VERSION from source against it"
PKG_CONFIG_PATH="$prefix/lib/pkgconfig" LDFLAGS="-Wl,-rpath,$prefix/lib" \
  "$py" -m pip install --no-binary av --no-deps --force-reinstall --no-cache-dir "av==$AV_VERSION"
"$py" "$here/check_lgpl_av.py" "$prefix"

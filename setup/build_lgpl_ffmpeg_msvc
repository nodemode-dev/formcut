#!/usr/bin/env bash
set -euo pipefail
msvc_bin="${1:?usage: setup/build_lgpl_ffmpeg_msvc <msvc bin> <work> <prefix> <ffmpeg version> <sha256>}"
work="${2:?}"
prefix="${3:?}"
version="${4:?}"
sha="${5:?}"
pacman -Sy --needed --noconfirm make diffutils nasm pkgconf >/dev/null
export PATH="$(cygpath -u "$msvc_bin"):$PATH"
command -v link | grep -qv '^/usr/bin/'
cd "$(cygpath -u "$work")"
tarball="ffmpeg-$version.tar.xz"
if [ -f "$tarball" ] && [ "$(sha256sum "$tarball" | cut -d' ' -f1)" != "$sha" ]; then
  echo "[lgpl-av] the $tarball already here has the wrong SHA-256, so it was removed"
  rm -f "$tarball"
fi
if [ ! -f "$tarball" ]; then
  for url in "https://ffmpeg.org/releases/$tarball" "https://dl.formai.studio/sources/ffmpeg/$tarball"; do
    if ! curl -fL --retry 3 -o "$tarball" "$url"; then
      echo "[lgpl-av] $url did not answer with $tarball; trying the next address"
      rm -f "$tarball"
      continue
    fi
    [ "$(sha256sum "$tarball" | cut -d' ' -f1)" = "$sha" ] && break
    echo "[lgpl-av] $url gave a $tarball with the wrong SHA-256, so it was removed; trying the next address"
    rm -f "$tarball"
  done
  [ -f "$tarball" ] || { echo "[lgpl-av] no address gave a $tarball with the expected SHA-256 (ffmpeg.org, dl.formai.studio); nothing was kept"; exit 1; }
fi
rm -rf src && mkdir src && tar -xJf "$tarball" -C src --strip-components 1
cd src
./configure --toolchain=msvc --prefix="$(cygpath -m "$prefix")" --enable-shared --disable-static \
  --disable-gpl --disable-nonfree --disable-version3 --disable-programs --disable-doc --disable-debug \
  --disable-autodetect --disable-network --enable-d3d11va --enable-dxva2 >/dev/null
make -j"$(nproc)" >/dev/null
make install >/dev/null

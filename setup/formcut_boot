#!/usr/bin/env bash
# formcut boot: the engine and the interface dev server, from the repo root.
# Lives in setup/; resolves the repo root itself.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

VERSION="$(sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([^"]*\)".*/\1/p' frontend/package.json | head -1)"

echo "==================================================="
echo "  formcut v${VERSION} - Boot"
echo "==================================================="

if [ ! -f backend/app/main.py ]; then
  echo "Error: backend/app/main.py not found under $ROOT"
  exit 1
fi
if [ ! -d backend/venv ]; then
  echo "Error: the engine is not installed. Run setup/formcut_oc_install"
  exit 1
fi
if [ ! -d frontend/node_modules ]; then
  echo "Error: the interface is not installed. Run setup/formcut_oc_install"
  exit 1
fi

# Keys and paths reach the engine through the environment, never the interface.
if [ -f .env ]; then
  set -a
  . ./.env
  set +a
else
  echo ""
  echo "No .env found. Copy example.env to .env for keys and paths; both are optional."
fi

# The native engine: formcut_native in backend/venv, current with this engine. Without it (or with an older build) the
# engine runs its slower Python path, which it did silently until 2.2.8. With Rust installed it is built here, once;
# FORMCUT_NATIVE_AUTOBUILD=0 skips that.
NATIVE="$(cd backend && ./venv/bin/python - <<'PY' 2>/dev/null | tail -1
import sys
sys.path.insert(0, ".")
from app.gpu_frame import API
try:
    import formcut_native
    probe = formcut_native.GpuFrame(64, 2)
    api = probe.api() if hasattr(probe, "api") else 1
    print("ready" if api >= API else f"an older build (api {api}, this engine wants {API})")
except Exception as exc:
    print(f"missing ({type(exc).__name__})")
PY
)"
echo ""
if [ "$NATIVE" = "ready" ]; then
  echo "Native engine: ready"
else
  echo "Native engine: ${NATIVE:-not found}"
  if [ "${FORMCUT_NATIVE_AUTOBUILD:-1}" != "0" ] && command -v cargo >/dev/null 2>&1; then
    echo "Building it now (setup/build_native_gpu); a few minutes the first time..."
    if setup/build_native_gpu; then echo "Native engine: built"; else echo "The native build failed (above); formcut runs on the slower Python path."; fi
  else
    echo "formcut runs on the slower Python path. Install Rust (https://rustup.rs), then run setup/build_native_gpu."
  fi
fi

echo ""
echo "Booting the engine..."
( cd backend && ./boot_backend ) &
BACKEND_PID=$!

sleep 2

echo ""
echo "Booting the interface..."
( cd frontend && ./boot_frontend ) &
FRONTEND_PID=$!

echo ""
echo "==========================================="
echo "    Services running:"
echo "    - Engine:    http://127.0.0.1:8040"
echo "    - Interface: http://localhost:3040"
echo "==========================================="
echo ""
echo "Press Ctrl+C to stop both"

trap 'kill $BACKEND_PID $FRONTEND_PID 2>/dev/null; exit' INT TERM
wait

#!/bin/sh
set -e

say() { printf '\n== %s ==\n' "$1"; }

say "Checking prerequisites"
command -v python3 >/dev/null || { echo "python3 is required (https://python.org)"; exit 1; }
command -v npm >/dev/null || { echo "npm is required (https://nodejs.org)"; exit 1; }
command -v cargo >/dev/null || { echo "Rust is required: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"; exit 1; }
xcode-select -p >/dev/null 2>&1 || { echo "Xcode command line tools are required: xcode-select --install"; exit 1; }
command -v ffmpeg >/dev/null || echo "note: ffmpeg not on PATH; the app runs, media probing and export need it"
cargo tauri --version >/dev/null 2>&1 || { say "Installing tauri-cli"; cargo install tauri-cli --version '^2' --locked; }

say "Building the frontend"
cd frontend
[ -d node_modules ] || npm install
npm run build
cd ..

say "Building the engine (Python -> single binary)"
cd backend
python3 -m venv .venv-package
. .venv-package/bin/activate
pip install --upgrade pip >/dev/null
pip install -r requirements.txt pyinstaller
python prepare_cv.py
python freeze.py --onefile
./dist/formcut-engine --selfcheck
deactivate
cd ..

say "Placing the sidecar for this machine's target triple"
TRIPLE=$(rustc -Vv | awk '/^host:/ {print $2}')
mkdir -p src-tauri/binaries
cp backend/dist/formcut-engine "src-tauri/binaries/formcut-engine-$TRIPLE"
echo "sidecar: src-tauri/binaries/formcut-engine-$TRIPLE"

say "Generating app icons"
cargo tauri icon src-tauri/icons/icon.png

say "Building the app bundle (this compiles Rust; first run takes a while)"
cargo tauri build --bundles app dmg

say "Done"
echo "App:  src-tauri/target/release/bundle/macos/formcut.app"
echo "DMG:  src-tauri/target/release/bundle/dmg/"
echo
echo "The bundle is unsigned. First launch: right-click the app > Open,"
echo "or clear quarantine: xattr -dr com.apple.quarantine src-tauri/target/release/bundle/macos/formcut.app"
echo
echo "Intel Macs: run this same script on an Intel machine, or add the target"
echo "(rustup target add x86_64-apple-darwin) and rebuild the sidecar there."

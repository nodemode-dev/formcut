#!/bin/sh
# Builds formcut for Linux: the AppImage, and the release zip holding it.
#
#   setup/build_linux_app
#
# The counterpart of setup/build_macos_app: the engine carries formcut's Rust kernels
# and is refused without them, formcut's verified ffmpeg is bundled, and
# setup/package_release.py writes release-dist/formcut-<version>-linux-<arch>.zip.
# The AppImage needs a glibc at least as new as the one it is built against, so build
# on the oldest distribution it should run on (the release builds on Ubuntu 22.04).
#
# Needs python3, npm, Rust, and Tauri's libraries:
#   sudo apt-get install libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev patchelf file
set -e

say() { printf '\n== %s ==\n' "$1"; }

case "$(uname -m)" in
  x86_64) TRIPLE=x86_64-unknown-linux-gnu ;;
  aarch64) TRIPLE=aarch64-unknown-linux-gnu ;;
  *) echo "unsupported architecture: $(uname -m)"; exit 1 ;;
esac

say "Checking prerequisites ($TRIPLE)"
command -v python3 >/dev/null || { echo "python3 is required"; exit 1; }
command -v npm >/dev/null || { echo "npm is required (https://nodejs.org)"; exit 1; }
command -v cargo >/dev/null || { echo "Rust is required: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"; exit 1; }
pkg-config --exists webkit2gtk-4.1 || { echo "Tauri's libraries are required: see the top of this script"; exit 1; }
echo "glibc: $(ldd --version | head -1 | awk '{print $NF}'); the AppImage needs this version or newer"

say "Building the frontend"
(cd frontend && npm ci --no-audit --no-fund && npm run build)

say "Building the engine for $TRIPLE (Python -> single binary, with formcut's Rust kernels)"
cd backend
VENV=.venv-package-linux
python3 -m venv "$VENV"
PY="$VENV/bin/python"
$PY -m pip install --upgrade pip >/dev/null
$PY -m pip install -r requirements.txt pyinstaller "maturin==1.15.0"
rm -rf native-dist
$PY -m maturin build --release --manifest-path native/Cargo.toml --interpreter "$PY" --features gpu --out native-dist
$PY -m pip install --force-reinstall --no-deps native-dist/*.whl
$PY -c "import formcut_native; print('kernels load:', formcut_native.__file__)" \
  || { echo "formcut's Rust kernels were built but do not load (the error is above); stopping."; exit 1; }
# With the GPU executor (Vulkan) every speed reading used; GpuFrame exists only with --features gpu.
$PY -c "import formcut_native, sys; sys.exit(0 if hasattr(formcut_native, 'GpuFrame') else 1)" \
  || { echo "formcut's Rust kernels were built without the GPU executor; stopping."; exit 1; }
$PY prepare_cv.py
$PY freeze.py --onefile
CHECK=$(./dist/formcut-engine --selfcheck)
echo "$CHECK"
case "$CHECK" in
  *'"native_kernels": true'*) ;;
  *) echo "The engine was frozen without formcut's Rust kernels; stopping rather than ship it."; exit 1 ;;
esac
cd ..

say "Placing the sidecar for $TRIPLE"
mkdir -p src-tauri/binaries
cp backend/dist/formcut-engine "src-tauri/binaries/formcut-engine-$TRIPLE"

say "Bundling formcut's ffmpeg for $TRIPLE"
"backend/$VENV/bin/python" setup/bundle_ffmpeg.py --target "$TRIPLE"

say "Building the AppImage for $TRIPLE (this compiles Rust; first run takes a while)"
# linuxdeploy is itself an AppImage; extracting it lets it run where FUSE is absent.
APPIMAGE_EXTRACT_AND_RUN=1 npx --yes @tauri-apps/cli@2 build --target "$TRIPLE" --bundles appimage

say "Packaging the release zip"
python3 setup/package_release.py --target "$TRIPLE"

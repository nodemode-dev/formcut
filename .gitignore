# dependencies and build output
node_modules/
dist/
build/
venv/
.venv/
__pycache__/
*.pyc
*.pyo
src-tauri/target/
src-tauri/binaries/*
!src-tauri/binaries/.gitignore
src-tauri/gen/
backend/dist/
backend/build/
backend/.venv-package/
backend/.venv-package-*/
backend/native-dist/
backend/*.spec

# local data, secrets and caches
.env
.env.*
!example.env
backend/data/
data/
models/*
!models/.gitkeep
*.log

# demo media: the four files the demo project loads, and their credits, are tracked
# (sources and licences in examples/demo/README.md); anything else here stays local
examples/demo/*
!examples/demo/.gitkeep
!examples/demo/README.md
!examples/demo/input-clip-example.mp4
!examples/demo/model-drop-MV.mp4
!examples/demo/a-sample.wav
!examples/demo/effect-example-image.jpg

# editor and platform noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
mcp/.venv/
release-dist/

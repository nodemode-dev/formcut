{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormCut",
  "version": "2.15.5",
  "identifier": "app.formcut.desktop",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "FormCut",
        "url": "splash.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "NodeAgentc, Inc.",
    "copyright": "Copyright 2026 NodeAgentc, Inc. Apache-2.0",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/formcut-engine"],
    "resources": { "ffmpeg/": "ffmpeg/", "../LICENSE": "LICENSE", "../NOTICE": "NOTICE", "../.docs/wiki/Licences.md": "Licences.md" },
    "linux": {
      "deb": {
        "recommends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      },
      "rpm": {
        "recommends": ["gstreamer1-plugins-base", "gstreamer1-plugins-good"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "entitlements": "./entitlements.plist"
    }
  }
}

# formcut environment
#
# Copy to .env in this folder and edit. The launchers (./formcut and
# formcut.bat) export everything in .env before starting the engine and the
# interface, so keys never live in the interface or in a project file. .env is
# ignored by git; example.env is the tracked template.
#
# Every variable below is read by the code. All are optional: without them the
# app runs locally with defaults and the features that need a key say so.

# --- API keys -----------------------------------------------------------------

# Stock media search (Pexels). Without it the stock panel reports the missing
# key instead of failing silently.
PEXELS_API_KEY=

# Hosted speech (ElevenLabs). Local speech through setup_local_ai needs no key;
# this is only for the hosted provider.
ELEVENLABS_API_KEY=

# --- Storage and assets -------------------------------------------------------

# Where media, projects, templates and renders live. Defaults to the
# platform data directory for your user.
# FORMCUT_DATA_DIR=/absolute/path/to/formcut-data

# Where AI models live. Defaults to models/ at the repository root when run
# from source, and to the data directory's models folder in the packaged app.
# FORMCUT_MODELS_DIR=/absolute/path/to/models

# Missing models download in the background when the engine starts. Set to 0
# to turn that off and install them from the Studio panel instead.
# FORMCUT_MODELS_AUTO=1

# Demo media folder, if you keep the four demo files somewhere else. The four
# expected names are input-clip-example.mp4, model-drop-MV.mp4, a-sample.wav and
# effect-example-image.jpg.
# FORMCUT_DEMO_DIR=/absolute/path/to/examples/demo

# Fallback font for rendered text when a project names no font file.
# FORMCUT_FONT_PATH=/absolute/path/to/font.ttf

# --- Engine -------------------------------------------------------------------

# Port for the engine. 0 picks a free port, which is what the desktop shell and
# the portable build use.
# FORMCUT_PORT=8000

# Serve a prebuilt interface from this folder instead of the dev server.
# FORMCUT_DIST=/absolute/path/to/frontend/dist

# Set to 1 to stop the portable launcher opening a browser window.
# FORMCUT_NO_BROWSER=0

# Python interpreter that carries the local speech runtime, if it is not the one
# setup_local_ai created in the data directory.
# FORMCUT_AI_PYTHON=/absolute/path/to/python

# --- Advanced -----------------------------------------------------------------

# Override a provider's endpoint, and the stock provider's allowed hosts. Only
# needed behind a proxy or mirror. Keys are better set in Settings, AI
# providers, which stores them in the engine and applies them without a restart.
# PEXELS_BASE=https://api.pexels.com
# ELEVENLABS_BASE=https://api.elevenlabs.io
# PEXELS_HOSTS=api.pexels.com,images.pexels.com,videos.pexels.com

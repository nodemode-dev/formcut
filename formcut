#!/usr/bin/env bash
# formcut - macOS/Linux launcher. Banner, install (idempotent), boot.
# Every step lives in setup/; this file only sequences them.
set -e
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

if [ "${1:-}" = desktop ] && [ "${2:-}" = build ]; then
  [ "$(uname -s)" = Darwin ] && exec setup/build_macos_app
  exec setup/build_linux_app
fi

# Agents: ./formcut mcp serves formcut over MCP's stdio (starting the engine when nothing answers), ./formcut claude
# starts Claude Code here connected to it, ./formcut agents install|sync|status sets Claude Code, Codex and Cursor up.
case "${1:-}" in
  mcp) shift; exec python3 setup/mcp_stdio.py "$@" ;;
  agents) shift; exec python3 setup/agents.py "$@" ;;
  claude)
    shift
    command -v claude >/dev/null 2>&1 || { echo "[formcut] Claude Code is not installed: https://claude.com/claude-code"; exit 1; }
    exec claude --mcp-config "{\"mcpServers\":{\"formcut\":{\"type\":\"stdio\",\"command\":\"$ROOT/formcut\",\"args\":[\"mcp\"]}}}" --allowedTools mcp__formcut "$@" ;;
esac

chmod +x setup/formcut_banner setup/formcut_oc_install setup/formcut_boot 2>/dev/null || true

# Boot banner. Never allowed to fail the launch: cosmetics do not gate startup.
bash setup/formcut_banner || true

setup/formcut_oc_install
bash setup/setup_local_ai || echo "Local speech runtime not installed; captions and editing still work. Re-run setup/setup_local_ai later."
exec setup/formcut_boot
